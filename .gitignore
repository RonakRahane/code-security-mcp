# Dependencies
node_modules/
.pnp
.pnp.*

# Build output
dist/
*.tsbuildinfo

# Test and coverage output
coverage/
.nyc_output/

# Environment files. Never commit real credentials.
# .env.example is checked in as documentation.
.env
.env.*
!.env.example

# Generated Sentinel reports. Scoped to the generated filenames so that a
# blanket *.md rule does not also exclude README.md and docs/.
sentinel-report.md
sentinel-report.html
sentinel-report.sarif
sentinel.sarif
*.sentinel.bak

# Keys and certificates
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
