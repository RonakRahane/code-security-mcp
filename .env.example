# Copy to .env and fill in. Never commit .env, it is gitignored.

# ─── GitHub integration ──────────────────────────────────────────────────────
# Required by scan_pr_diff and post_security_review.
# Create at https://github.com/settings/tokens
# Scope: 'repo' for private repositories, 'public_repo' for public only.
GITHUB_TOKEN=

# ─── Workspace confinement (recommended) ─────────────────────────────────────
# Path-delimited list of directories Sentinel is allowed to read.
# Tool arguments come from a model that has been reading the repository under
# scan, so they are untrusted input. Setting this confines every tool to these
# roots. Unset means no restriction, which is fine locally but wrong for a
# shared or hosted deployment.
#   POSIX:   /home/me/work:/home/me/projects
#   Windows: C:\work;C:\projects
SENTINEL_ALLOWED_ROOTS=

# ─── Network policy ──────────────────────────────────────────────────────────
# Set to 1 for air-gapped or privacy-sensitive environments. Disables OSV
# advisory lookups and registry rule downloads. The scan then reports that
# dependency results are incomplete rather than returning an empty list.
SENTINEL_OFFLINE=

# Semgrep registry packs, comma-separated (for example "p/javascript,p/python").
# Empty by default: registry packs are downloaded at scan time, so enabling them
# means results depend on network access and on the registry's current contents.
SENTINEL_SEMGREP_REGISTRY=

# ─── Engine and diagnostics ──────────────────────────────────────────────────
# Path to the Semgrep binary if it is not on PATH. When set, this is the only
# candidate tried: a wrong path is reported rather than quietly replaced by
# another Semgrep on the machine, so a pinned build stays the one that runs.
SENTINEL_SEMGREP_BIN=

# Set to 1 where installing software at runtime is the wrong behaviour, such as
# a locked-down CI runner or a prebuilt image. Sentinel normally installs
# Semgrep itself when it is missing, because a scan without it silently reports
# nothing for every bug that needs data flow to see.
SENTINEL_NO_AUTO_INSTALL=

# Pin the Semgrep version to install, for example 1.100.0. Empty takes the
# current release. Anything that is not a plain version is ignored.
SENTINEL_SEMGREP_VERSION=

# debug | info | warn (default) | error | silent
# Logs are written to stderr as structured JSON. Use debug to see per-path
# detail behind a "coverage gap" warning.
SENTINEL_LOG_LEVEL=

# Parallel file reads (1-64). Defaults to 16.
SENTINEL_CONCURRENCY=
